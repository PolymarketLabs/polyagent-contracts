# forge script --broadcast 使用的广播账户私钥
PRIVATE_KEY=

# 本地 Anvil RPC 地址
LOCAL_RPC_URL=http://127.0.0.1:8545

# Polygon Amoy RPC 地址
POLYGON_AMOY_RPC_URL=

# Polygon 主网 RPC 地址
POLYGON_MAINNET_RPC_URL=

# Etherscan 源码验证使用的 API Key
ETHERSCAN_API_KEY=

# Vault 的 UpgradeableBeacon 地址（DeployVaultFactory.s.sol / UpgradeVault.s.sol 使用）
BEACON=

# VaultFactory 的 UUPS 代理地址（UpgradeVaultFactory.s.sol 使用）
FACTORY_PROXY=
